# Copy to .env and fill in. The real .env is gitignored.

# App
NODE_ENV=development
PORT=3001

# Auth
JWT_KEY=change-me-to-a-long-random-secret

# --- Development database (NODE_ENV=development) ---
DEV_DB_USERNAME=conduit
DEV_DB_PASSWORD=conduit
DEV_DB_NAME=conduit_dev
DEV_DB_HOSTNAME=localhost
DEV_DB_DIALECT=postgres
DEV_DB_LOGGING=false

# --- Test database (NODE_ENV=test) ---
TEST_DB_USERNAME=conduit
TEST_DB_PASSWORD=conduit
TEST_DB_NAME=conduit_test
TEST_DB_HOSTNAME=localhost
TEST_DB_DIALECT=postgres
TEST_DB_LOGGING=false

# --- Production database (NODE_ENV=production) ---
PROD_DB_USERNAME=conduit
PROD_DB_PASSWORD=conduit
PROD_DB_NAME=conduit
PROD_DB_HOSTNAME=postgres
PROD_DB_DIALECT=postgres
PROD_DB_LOGGING=false

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=admin
